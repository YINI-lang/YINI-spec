/*
    Lists with some newlines <NL> and comments in between.
*/

^ Lists3


^^ ListWithBrackets

// List with brackets.

list1 = [ "Orange", "Banana", "Pear", "Peach" ] // Comment.
list2 = []  // Empty list.
// List with brackets.
listOfLists = [
		["stylesheet", "https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"],
		["stylesheet", "css/general.css"],
		["stylesheet", "css/themes.css"]    // Last element.
	]


// List without brackets.
^^ ListWithoutBrackets

    // List without brackets.
	listOfLists:
		["stylesheet", "https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"],
		["stylesheet", "css/general.css"],

		["stylesheet", "css/themes.css"]



