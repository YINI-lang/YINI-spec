// Rule: b, B, and every capitalization of block select the same string form.
// Prefix capitalization does not change the case of the content.
script = block"""
  echo "first"

    echo 'nested'
  echo C:\source\file.txt
"""

literal_quotes = Block"""
    echo '""" stays literal inside this line'
"""

empty = BLOCK"""
"""

query = bLoCk"""
    SELECT id, name
    FROM users
    WHERE active = TRUE;
"""

indented_close = b"""
  Keep MiXeD CaSe and literal \n.
  """

joined = "run: " + B"""
    npm test
"""

// Both values are Hello. Comments after closing quotes are outside the block.
slash_note = b"""
  Hello
""" // A comment
hash_note = b"""
  Hello
"""# A comment

// Comment markers on content lines are literal text.
markers = b"""
  // one
  # two
  /* three */
"""

// The punctuation after each block belongs to the surrounding expression.
message = b"""
  Hello
""" + /* Add punctuation. */ "!"
items = [b"""
  one
""", /* The next item
        is on the following line. */
  "two"]
object = {first: b"""
  red
""", second: "blue"}
quoted = '"""Docstring"""'

// Prefix spellings remain valid identifiers when not introducing a string.
block = "full prefix as a key"
b = "short prefix as a key"
binary = 0b1010
classic = E"classic\nstring"
