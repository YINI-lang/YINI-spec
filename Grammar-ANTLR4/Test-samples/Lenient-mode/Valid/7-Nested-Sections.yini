# Up to nine levels using repeated carets in RC 6.

^ Application
appName = "MyApp"
version = "1.0.0"

  ^^ Database
  host = "db.example.com"
  port = 5432

    ^^^ Credentials
    username = "admin"
    password = "secret"

      ^^^^ Pools
      maxConnections = 20
      minConnections = 2

        ^^^^^ Timeouts
        connectTimeout = 5000
        readTimeout    = 15000

          ^^^^^^ Logging
          level = "INFO"
          path  = "/var/log/myapp.log"

            ^^^^^^^ Metrics
            enabled = true

              ^^^^^^^^ Retention
              days = 30

                ^^^^^^^^^ Archive
                target = "cold-storage"

# For level 10 and deeper, use numeric shorthand such as ^10.
