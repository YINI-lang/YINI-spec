# Up to six levels using repeated carets

^ Application
appName = "MyApp"
version = "1.0.0"

  ^^ Database
  host = "db.example.com"
  port = 5432

    ^^^ Credentials
    username = "admin"
    password = "secret"

      ^^^^ Pools
      maxConnections = 20
      minConnections = 2

        ^^^^^ Timeouts
        connectTimeout = 5000
        readTimeout    = 15000

          ^^^^^^ Logging
          level = "INFO"
          path  = "/var/log/myapp.log"

# If we tried to go to level 7 here (e.g. ^^^^^^^ TooDeep),
# the parser would reject it—use the ^<n> shorthand instead.
