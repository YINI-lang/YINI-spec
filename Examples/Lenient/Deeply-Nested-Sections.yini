/*
  Nesting level respected, no missing intermediary levels.

  RC 6 allows repeated section markers through level 9. The optional `_`
  separator can make deeper repeated-marker headers easier to read.
  Numeric shorthand is used for level 10 and deeper.
*/

^ Root                             # level 1
rootKey = "rootValue"

^^ Level2                          # level 2
level2Key = 42

^^^ Level3                         # level 3
level3Key = true

^^^^ Level4                        # level 4
level4Key = null

^^^^^ Level5                       # level 5
level5Key = "hello"

^^^^^^ Level6                      # level 6
level6Key = [1, 2, 3]

^^^^_^^^ Level7Separated           # level 7
level7Key = "deepValue"

^^^^_^^^^ Level8Separated          # level 8
level8Key = 3.14159

^^^_^^^_^^^ Level9Separated        # level 9
level9Key = hex:FFAA00

^10 Level10Shorthand               # level 10
level10Key = "numeric shorthand"
