/*
    Example 2 of a package yini - a more advanced version.

    * Uses bracketed lists for authors and excluded paths.
*/

^ myPackage
name = "SomeName"
description = "Some description of something."
version = "1.8.4"
authors = [
    "Mark O. Smith",
    "Gandalf Olórin, the Grey<something@domain.com>",
    "Galadriel"
]
exclude = [
    "build",
    "docs",
    "examples",
    "packages"
]

^ devDependencies
tester = "bin/tester@1.1.4"
