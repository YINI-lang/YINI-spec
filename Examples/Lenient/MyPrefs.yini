/*
   Indentation doesn't matter, it's just for readability, you can indent however you want.
*/

@yini

^ MyPrefs

	^^ General
	IsDarkMode = YES
	Buffers = 10
	Themes = ["Classic", "Modern"]
	// Strings are raw by default, so backslashes are literal here.
	Dirs = ["C:\Users\", "D:\Work\Temp\", "E:\Data\Temp\"]

	^^ Menu 
	Id = "FILE"
	Value = "File"

		^^^ MenuItem
		Value = "New"
		OnClick = "CreateDoc()"

		^^^ MenuItem2
		Value = "Open"
		OnClick = "OpenDoc()"

		^^^ MenuItem3
		Value = "Save"
		OnClick = "SaveDoc()"
