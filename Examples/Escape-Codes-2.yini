// Escape Sequences: Hex, Unicode, Octal

// Hexadecimal escape: \xNN (2-digit hex)
hexChar = C"\x48\x65\x6C\x6C\x6F"  // "Hello"

// Unicode escape (4-digit): \uNNNN
unicodeChar = C"\u2603"            // Unicode snowman ☃

// Unicode escape (8-digit): \UNNNNNNNN
unicodeLong = C"\U0001F984"        // Unicode unicorn 🦄

// Octal escape: \ooo (3-digit octal)
octalChar = C"\110\145\154\154\157" // "Hello"
