{
    "Application": {
        "name": "Section Demo",
        "environment": "development",
        "Server": {
            "host": "localhost",
            "port": 8080
        },
        "Logging": {
            "level": "info",
            "outputs": ["console", "file"]
        }
    },
    "Features": {
        "enabled": true,
        "Search": {
            "provider": "local",
            "cache": {
                "enabled": true,
                "ttlSeconds": 300
            }
        }
    }
}
